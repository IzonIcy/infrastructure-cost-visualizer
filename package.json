{
  "name": "infrastructure-cost-visualizer",
  "version": "0.1.0",
  "private": true,
  "description": "Browser-based dashboard to estimate and explore infrastructure spend. Optional Node backend for scenario persistence.",
  "type": "module",
  "scripts": {
    "dev": "node ./server/index.js",
    "start": "NODE_ENV=production node ./server/index.js",
    "smoke": "node ./server/smoke.js",
    "prepare": "husky",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint ."
  },
  "dependencies": {
    "express": "^5.1.0",
    "helmet": "^8.3.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.9.1",
    "globals": "^17.11.0",
    "husky": "^9.1.7",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.31.0"
}
